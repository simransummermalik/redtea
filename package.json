{
  "name": "redtea",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun run dev:server & bun run dev:web",
    "dev:server": "bun --filter @redtea/server dev",
    "dev:web": "bun --filter @redtea/web dev",
    "build:web": "bun --filter @redtea/web build",
    "load:server": "bun apps/server/scripts/load.ts",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "words:build": "bun --filter @redtea/words build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
