{
  "name": "redtea",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev:web": "bun --filter @redtea/web dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "words:build": "bun --filter @redtea/words build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
